# Copy to .env.local. Never commit .env.local or paste credentials into chat.
# Default local mode is for development only. Production is read-only without Sanity.
CONTENT_STORAGE=local

# Existing shared-password /admin login.
# Production: at least 8 characters; session secret >=32 characters, different from password.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Persistent content. Set CONTENT_STORAGE=sanity after creating a project.
# Keep these server-only: never add NEXT_PUBLIC_ to them.
SANITY_PROJECT_ID=
SANITY_DATASET=varosha-test
SANITY_API_TOKEN=
